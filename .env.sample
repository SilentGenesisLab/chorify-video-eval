# 复制为 .env 后填写：cp .env.sample .env && chmod 600 .env
# 评审器（video_review.py）、基准测试和网站后台任务都从这里读取

# DeepSeek API Key，在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：换用其他 OpenAI 兼容接口（填了 REVIEW_API_KEY 就不再需要 DEEPSEEK_API_KEY）
# REVIEW_API_URL=https://api.sligenai.cn/v1/chat/completions
# REVIEW_API_KEY=sk-xxxxxxxx
# REVIEW_MODEL=claude-opus-5-5
