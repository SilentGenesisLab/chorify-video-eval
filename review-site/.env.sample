# 复制为 .env.local 后填写：cp .env.sample .env.local && chmod 600 .env.local
# serve.sh 启动时加载本文件；修改后执行 ./serve.sh restart

# 网页登录密码（浏览器弹窗，用户名任意）。生成：openssl rand -base64 12
SITE_PASSWORD=change-me

# HTTP 接口 Token，调用方用 Authorization: Bearer <token> 或 X-API-Key: <token>
# 生成：echo "vr_$(openssl rand -hex 20)"
SITE_API_TOKEN=vr_change-me

# 对外访问地址：接口返回的链接和接口文档里的示例都用它，不要带末尾斜杠
PUBLIC_BASE_URL=http://localhost:3100

# 同时执行的评审任务数。每个任务约占 100MB 内存，1GB 内存的机器建议 2
MAX_RUNNING=2

# 以下可选，一般不用改
# PORT=3100                       # 监听端口（serve.sh 使用）
# PYTHON=/path/to/.venv/bin/python   # 默认 <仓库根>/.venv/bin/python
# REVIEW_ROOT=/path/to/repo          # 默认 review-site 的上一级目录
# DEEPSEEK_API_KEY=                  # 默认读取仓库根目录 .env
